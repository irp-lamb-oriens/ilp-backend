# Firestore service account JSON (inline) or a path to the JSON file
SERVICE_ACCOUNT_KEY=

# Runtime
PORT=8000
RENDER_EXTERNAL_URL=

# Scheduler
CRON_RUNNER_ENABLED=false

# User-session JWT secret (the platform's own tokens)
JWT_SECRET=

# Identity provider / auth (placeholder - see config/integrations.ts)
AUTH_PROVIDER_URL=

# Staff notifications + dashboard URL
STAFF_NOTIFY_EMAIL=
DASHBOARD_URL=http://localhost:3000