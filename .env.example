# ── Firestore service account ─────────────────────────────
# LOCAL: a relative path to the gitignored credential file works.
#   SERVICE_ACCOUNT_KEY=./serviceaccount.json
# PRODUCTION (Render): there is no filesystem file, so paste the FULL
#   service-account JSON inline as the value (the code parses inline JSON
#   when the value starts with "{").
#   SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...",...}
SERVICE_ACCOUNT_KEY=

# ── Runtime ───────────────────────────────────────────────
# Render injects PORT automatically; leave this as a fallback.
PORT=8000

# Render injects RENDER_EXTERNAL_URL automatically for web services.
# Set it explicitly only if you need to override the public URL.
RENDER_EXTERNAL_URL=https://ilp-backend-nlbz.onrender.com

# ── Scheduler ─────────────────────────────────────────────
# PRODUCTION: set to "true" so the cron jobs run (email queue, alert
# generation, alert dispatch, escalation). The runner only starts when the
# base URL is not localhost AND this is "true".
CRON_RUNNER_ENABLED=true

# ── User-session JWT secret ───────────────────────────────
# Keep the same strong value in Render's environment variables.
JWT_SECRET=

# ── Dashboard URL ─────────────────────────────────────────
# PRODUCTION: the deployed frontend URL (used in escalation emails).
DASHBOARD_URL=https://internationallegalpartner.netlify.app

# ── OpenAI (LLM + audio transcription) ────────────────────
# Used by API/chatbot/intelligence/transcription.ts transcribeAudio() and
# config/integrations.ts transcribeAudio(). Required for the voice-transcribe
# endpoint and the multi-agent chatbot LLM.
OPENAI_API_KEY=

# ── OpenRouter (LLM + voice transcription) ────────────────
# Primary LLM key for the chatbot multi-agent chain. Mirrors IRP-funnel's
# OPENROUTER_API_KEY / OPENROUTER_KEY_WEB_CHAT.
OPENROUTER_API_KEY=

# Gemini 2.5 Flash via OpenRouter, used by the dashboard voice-transcribe
# endpoint. Mirrors IRP-funnel's OPENROUTER_KEY_VOICE.
OPENROUTER_KEY_VOICE=

# ── Google Calendar ───────────────────────────────────────
# The ILP calendar (a group calendar in the ILP Google Workspace).
CALENDAR_ID=
# Required: Workspace user the service account impersonates (domain-wide
# delegation). No default; Calendar, Meet and transcripts fail without it.
GOOGLE_SUBJECT_EMAIL=
# Service account with domain-wide delegation for Calendar (separate from the
# Firestore SERVICE_ACCOUNT_KEY). Paste the full JSON inline.
CALENDAR_SERVICE_ACCOUNT_KEY=

# ── SMTP (email delivery) ─────────────────────────────────
# Used by config/integrations.ts sendEmailTransport(). Leave blank to keep
# the email integration in NOT_IMPLEMENTED mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@internationallegalpartner.com

# ── Security ──────────────────────────────────────────────
# Comma-separated front-end origins allowed by CORS (production).
#   ALLOWED_ORIGINS=https://app.internationallegalpartner.com
ALLOWED_ORIGINS=
# Secret mixed into stored OTP hashes. Set to a long random string.
OTP_PEPPER=

# P1 ── Security, document storage, operations ──
# "true" re-enables legacy header / ?token= session tokens and returns `token`
# from verify-otp (seed scripts, local tools). Leave unset in production:
# sessions are HttpOnly cookies only.
AUTH_HEADER_TOKENS=
# Private Cloud Storage bucket for member documents (members/<clientId>/<docId>).
# The service account needs roles/storage.objectAdmin on it. Unset in dev =
# files kept inline in Firestore (700 KB); unset in production = uploads refused.
DOCUMENT_BUCKET=
# Optional Sentry DSN (https://<key>@<host>/<projectId>). Errors always go to
# the error_log collection; with a DSN they are also posted to Sentry.
SENTRY_DSN=
# Secret for GET /health/deep (send it as the x-health-token header). Unset = 404.
HEALTH_TOKEN=
# Bucket for the daily Firestore export (gs://$BACKUP_BUCKET/<YYYY-MM-DD>, 03:00
# Costa Rica). Unset = backup job is a logged no-op. Needs CRON_RUNNER_ENABLED=true.
BACKUP_BUCKET=

# P2 ── Payments lifecycle, retention messages, PMF measurement ──
# "stripe" = Stripe Checkout + webhooks; anything else = manual (staff "Mark paid").
PAYMENTS_MODE=manual
# sk_test_… for test mode. A live key (sk_live_/rk_live_) is refused unless STRIPE_ALLOW_LIVE=true.
STRIPE_SECRET_KEY=
STRIPE_ALLOW_LIVE=false
# Demo only: activate memberships on join without payment (manual mode).
PAYMENTS_DEMO_AUTOPAY=false
# Public site used in Stripe return URLs and in member email links (/status/money, /status/feedback).
PUBLIC_SITE_URL=http://localhost:3000
# Public base URL of this API, used in email links that hit the server directly (unsubscribe).
PUBLIC_API_URL=http://localhost:8000
# HMAC secret for unsubscribe links (falls back to OTP_PEPPER). Long random string.
RETENTION_LINK_SECRET=
# P3 ── The call: availability, Google Meet, reminders, transcripts ─────────
# Lawyer for members with no assigned lawyer and no specialty match.
DEFAULT_PROVIDER_ID=
# Public front-end URL used in reminder emails (brief and member home links).
FRONTEND_URL=https://app.internationallegalpartner.com
# Google sends its own invitation/update emails to call attendees:
# all (default) | externalOnly | none
CALENDAR_SEND_UPDATES=all
# Reminders run from the cron runner (jobs/callReminders.ts, every 15 min);
# it only starts with CRON_RUNNER_ENABLED=true on a non-localhost BASE_URL.
# Google scopes needed (domain-wide delegation for CALENDAR_SERVICE_ACCOUNT_KEY,
# impersonating GOOGLE_SUBJECT_EMAIL): calendar, calendar.events.readonly,
# drive.readonly (already in helper/getGoogleAuthClient.ts DEFAULT_GOOGLE_SCOPES).

# W1 / P4 ── Staff roles, cookies, CSM ownership, demo seed ─────────────────
# Owner of auto-created CSM tasks when the membership has no csmEmail.
DEFAULT_CSM_EMAIL=
# Comma-separated staff emails per role (everyone else on the staff domain is "staff").
ADMIN_EMAILS=
CSM_EMAILS=
# Staff accounts must be on this domain (dashboard login and staff bypass).
DASHBOARD_ALLOWED_DOMAIN=internationallegalpartner.com
# Session cookies: SameSite=None when the API and the site are on different sites
# (then ALLOWED_ORIGINS must list the site); COOKIE_DOMAIN to share across subdomains;
# COOKIE_INSECURE=true only for plain-http local dev.
COOKIE_SAMESITE=Lax
COOKIE_DOMAIN=
COOKIE_INSECURE=false
# Web Push (member deadline notifications). Generate a P-256 keypair once.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@internationallegalpartner.com
# scripts/seedDemo.ts: real inboxes so OTP login works on the demo accounts.
DEMO_CSM_EMAIL=
DEMO_LAWYER_EMAIL=
DEMO_MEMBER_EMAIL=

# P6 ── Privacy, consent records, retention, CSP reports ───────────────────
# All periods are placeholders for ILP's counsel to confirm (docs/PRIVACY_AND_COMPLIANCE.md).
# Business days to answer a privacy request (access, correction, deletion, objection).
PRIVACY_RESPONSE_DAYS=10
# Owner of the CSM task a privacy request opens (falls back to DEFAULT_CSM_EMAIL). Use an admin.
PRIVACY_OWNER_EMAIL=
# Daily jobs/privacyRetention.ts (needs CRON_RUNNER_ENABLED=true).
RETENTION_LEAD_MONTHS=12
RETENTION_ERROR_LOG_DAYS=90
RETENTION_FUNNEL_MONTHS=13
RETENTION_TRANSCRIPT_MONTHS=24
RETENTION_CHATBOT_MONTHS=6
RETENTION_EMAIL_QUEUE_DAYS=90
RETENTION_SESSION_GRACE_DAYS=1
RETENTION_MAX_DELETES_PER_RUN=500
# CSP violation reports arrive at POST /api/csp-report (no setting needed);
# the site's CSP_MODE is a front-end variable (frontend/src/middleware.ts).
